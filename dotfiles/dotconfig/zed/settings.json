// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "cli_default_open_behavior": "new_window",
    "diagnostics": {
        "inline": {
            "enabled": true
        }
    },
    "project_panel": {
        "dock": "left"
    },
    "outline_panel": {
        "dock": "left"
    },
    "git_panel": {
        "dock": "left",
        "tree_view": true
    },
    "bottom_dock_layout": "contained",
    "vim": {
        "cursor_shape": {
            "insert": "block",
        },
    },
    "buffer_line_height": "standard",
    "minimap": {
        "show": "always",
    },
    "toolbar": {
        "breadcrumbs": true,
        "quick_actions": true,
        "selections_menu": false,
        "code_actions": true,
    },
    "scrollbar": {
        "show": "never",
    },
    "centered_layout": {
        "left_padding": 0.15,
        "right_padding": 0.15,
    },
    "colorize_brackets": false,
    "base_keymap": "VSCode",
    "icon_theme": "Catppuccin Macchiato",
    "tab_size": 4,
    "ui_font_family": "Geist Mono",
    "agent": {
        "sidebar_side": "right",
        "dock": "right",
        "tool_permissions": {
            "tools": {
                "terminal": {
                    "default": "allow",
                },
            },
        },
        "notify_when_agent_waiting": "never",
        "default_profile": "write",
        "default_model": {
            "effort": "medium",
            "enable_thinking": true,
            "provider": "zed.dev",
            "model": "gpt-5.4",
        },
        "model_parameters": [],
    },
    "disable_ai": false,
    "buffer_font_size": 18.0,
    "buffer_font_features": {
        "calt": false,
    },
    "ui_font_size": 18.0,
    "buffer_font_family": "GeistMono Nerd Font Mono",
    "vim_mode": true,
    "relative_line_numbers": "enabled",
    "cursor_blink": false,
    "cursor_shape": "block",
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "viis",
    },
    "collaboration_panel": { "dock": "left",
                             "button": false },
    "notification_panel": { "button": false },
}
